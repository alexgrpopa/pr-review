{
  "name": "@alexgrpopa/pr-review",
  "version": "0.1.0",
  "description": "Review a pull request locally with Claude Code and post the result as a GitHub App.",
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "pr-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "CONTEXT.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgrpopa/pr-review.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
